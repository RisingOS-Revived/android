  <project path="frameworks/native" name="android_frameworks_native" groups="pdk" remote="rising" />
  <project path="frameworks/opt/net/wifi" name="android_frameworks_opt_net_wifi" groups="pdk,sysui-studio" remote="rising" />
  <project path="frameworks/opt/telephony" name="android_frameworks_opt_telephony" groups="pdk" remote="rising" />

  <!-- Hardware -->
