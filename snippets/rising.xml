  <project path="packages/apps/Backgrounds" name="android_packages_apps_Backgrounds" remote="rising" />
  <project path="packages/apps/BtHelper" name="android_packages_apps_BtHelper" remote="rising" />
  <project path="packages/apps/ColumbusService" name="android_packages_apps_ColumbusService" remote="rising" />
